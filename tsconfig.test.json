// The type check of the suite, mise run types:test: the tests and their helpers, which node runs
// under its type stripping, and scripts/screenshots.config.ts, which the tooling's bin runs the
// same way, checked against dist/ as a consumer's code is and never emitted. allowJs reads the
// browser tier's in-page support/ module, which stays .js because the server sends it as written.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "noEmit": true,
    "allowJs": true,
    "rootDir": "."
  },
  "include": ["test/**/*.ts", "scripts/**/*.ts"]
}
